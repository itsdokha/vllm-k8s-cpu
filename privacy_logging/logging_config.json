{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "redact_prompts": {
      "()": "privacy_logging.PromptRedactionFilter"
    }
  },
  "formatters": {
    "vllm": {
      "()": "vllm.logging_utils.NewLineFormatter",
      "format": "(%(vllm_process_name)s pid=%(process)d) %(levelname)s %(asctime)s [%(fileinfo)s:%(lineno)d] %(message)s",
      "datefmt": "%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "vllm": {
      "class": "logging.StreamHandler",
      "formatter": "vllm",
      "filters": ["redact_prompts"],
      "level": "INFO",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "vllm": {
      "handlers": ["vllm"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["vllm"],
    "level": "WARNING"
  }
}
