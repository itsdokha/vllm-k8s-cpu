# Qwen2.5-1.5B-Instruct, квантизация W8A8 int8 (compressed-tensors, Red Hat AI).
# На x86 без AVX512 vLLM считает её через oneDNN int8 (AVX-VNNI). bf16 на таком
# CPU уходит в медленный запасной путь, а AWQ int4 в AVX2-сборке vLLM нет.
MODEL_ID=RedHatAI/Qwen2.5-1.5B-Instruct-quantized.w8a8
MODEL_REVISION=876ae8e2b9982d9603afd3c71add6b3b4b0bc0b6
MODEL_DIR=/models/qwen2.5-1.5b-instruct-w8a8
# При смене модели старая удаляется с PVC, чтобы не копить гигабайты.
PRUNE_OTHER_MODELS=true
