# Память под KV-кэш на CPU, ГиБ. 2 ГиБ это ~75 тыс. токенов, с запасом
# для 8 параллельных запросов по 3 тыс. токенов. Модель в памяти занимает
# ~4 ГиБ, вместе с кэшем и рантаймом укладываемся в ноду minikube на 12 ГБ.
VLLM_CPU_KVCACHE_SPACE=2
# Привязка OpenMP-потоков к ядрам. auto берёт ядра, доступные контейнеру.
VLLM_CPU_OMP_THREADS_BIND=auto
VLLM_LOGGING_LEVEL=INFO
